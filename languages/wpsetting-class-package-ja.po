msgid "The login URL was not changed. Choose a different slug."
msgstr "ログインURLは変更していません。別のスラッグを指定してください。"

#: src/ItmarSecuritySettings.php:348
msgid "Security Settings"
msgstr "セキュリティ設定"

#: src/ItmarSecuritySettings.php:351
msgid "Custom Login URL"
msgstr "カスタムログインURL"

#: src/ItmarSecuritySettings.php:354
msgid "Change the default login URL (wp-login.php)."
msgstr "デフォルトのログイン URL (wp-login.php) を変更します。"

#: src/ItmarSecuritySettings.php:357
msgid "Current login URL:"
msgstr "現在のログインURL:"

#: src/ItmarSecuritySettings.php:361
msgid ""
"Bookmark this URL. While it is set, wp-login.php returns 404 for both GET "
"and POST. Clearing this field restores the default login URL."
msgstr ""
"このURLをブックマークしてください。設定されている間、wp-login.php は GET・"
"POST とも 404 を返します。この欄を空にすると既定のログインURLに戻ります。"

#: src/ItmarSecuritySettings.php:367
msgid "Disable Author Archives & REST API User Endpoint"
msgstr "著者アーカイブとREST APIユーザーエンドポイントを無効にする"

#: src/ItmarSecuritySettings.php:371
msgid "Block access to /?author= and REST API /wp/v2/users."
msgstr "/?author= および REST API /wp/v2/users へのアクセスをブロックします。"

#: src/ItmarSecuritySettings.php:376
msgid "Disable XML-RPC"
msgstr "XML-RPCを無効にする"

#: src/ItmarSecuritySettings.php:380
msgid "Disable XML-RPC endpoint (used for pingbacks, remote publishing, etc)."
msgstr ""
"XML-RPC エンドポイントを無効にします (pingback、リモート公開などに使用されま"
"す)。"

#: src/ItmarSEOSettings.php:320
msgid "OGP Settings"
msgstr "OGP設定"

#: src/ItmarSEOSettings.php:323
msgid "Enable OGP Tags"
msgstr "OGP タグを有効にする"

#: src/ItmarSEOSettings.php:327
